{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthropic-docs-local/schemas/manifest.schema.json",
  "title": "Anthropic Docs Local Manifest",
  "description": "Schema for the manifest.json file that tracks all documentation sources",
  "type": "object",
  "required": ["schema_version", "last_full_update", "sources"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the manifest schema"
    },
    "last_full_update": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last full update"
    },
    "sources": {
      "type": "array",
      "description": "Array of documentation source entries",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "category", "local_path", "source_url", "source_type", "last_fetched"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique identifier (lowercase, hyphens only)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name"
        },
        "category": {
          "type": "string",
          "enum": [
            "api",
            "models",
            "sdks",
            "claude-code",
            "agent-sdk",
            "skills",
            "cookbooks",
            "release-notes",
            "github-repos",
            "research"
          ],
          "description": "Content category"
        },
        "local_path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9/_.-]+$",
          "description": "Relative path from repo root"
        },
        "source_url": {
          "type": "string",
          "description": "Original source URL or agent identifier"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "github-raw",
            "github-api",
            "web-extracted",
            "manual",
            "arxiv-pdfs"
          ],
          "description": "How the source is fetched"
        },
        "last_fetched": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last fetch"
        },
        "review_status": {
          "type": "string",
          "enum": ["auto", "human-verified", "needs-review"],
          "description": "Review status for scalable oversight"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score (0.0-1.0)"
        },
        "last_human_review": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last human review"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 checksum for integrity verification"
        },
        "papers": {
          "type": "array",
          "description": "Array of paper entries (for arxiv-pdfs type)",
          "items": {
            "$ref": "#/$defs/paper"
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "required": ["file", "arxiv", "title"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.pdf$",
          "description": "PDF filename"
        },
        "arxiv": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}$",
          "description": "arXiv identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Paper title"
        }
      }
    }
  }
}
